#ifndef ASSFONTS_ASSFONTS_H_
#define ASSFONTS_ASSFONTS_H_

// clang-format off
#define ASSFONTS_VERSION_MAJOR @VERSION_MAJOR@
#define ASSFONTS_VERSION_MINOR @VERSION_MINOR@
#define ASSFONTS_VERSION_PATCH @VERSION_PATCH@
// clang-format on

enum ASSFONTS_LOG_LEVEL {
  ASSFONTS_INFO = 0,
  ASSFONTS_WARN,
  ASSFONTS_ERROR,
  ASSFONTS_TEXT,
  ASSFONTS_NONE
};

extern "C" {

typedef void (*AssfontsLogCallback)(const char* msg,
                                    const enum ASSFONTS_LOG_LEVEL log_level);

void AssfontsBuildDB(const char** fonts_paths, const unsigned int num_fonts,
                     const char* db_path, const AssfontsLogCallback cb,
                     const enum ASSFONTS_LOG_LEVEL log_level);

void AssfontsRun(const char** input_paths, const unsigned int num_paths,
                 const char* output_path, const char** fonts_paths,
                 const unsigned int num_fonts, const char* db_path,
                 const unsigned int brightness,
                 const unsigned int is_subset_only,
                 const unsigned int is_embed_only, const unsigned int is_rename,
                 const unsigned int is_font_combined,
                 const unsigned int is_non_ttf_quiet,
                 const unsigned int num_thread, const AssfontsLogCallback cb,
                 const enum ASSFONTS_LOG_LEVEL log_level);

// Check which fonts each input subtitle uses and whether they are in the
// fonts database. Returns a UTF-8 JSON array (one object per input), which
// must be released with AssfontsFreeString.
char* AssfontsCheck(const char** input_paths, const unsigned int num_paths,
                    const char* db_path, const AssfontsLogCallback cb,
                    const enum ASSFONTS_LOG_LEVEL log_level);

// Same as AssfontsCheck, but looks only at the fonts in the given folders
// (no database, no system fonts), e.g. a font pack shipped with a subtitle.
char* AssfontsCheckFonts(const char** input_paths, const unsigned int num_paths,
                         const char** fonts_paths, const unsigned int num_fonts,
                         const AssfontsLogCallback cb,
                         const enum ASSFONTS_LOG_LEVEL log_level);

// Parses the given font files and adds them to the fonts database, replacing
// what it held for the same paths. Other entries are kept as they are.
void AssfontsAddFonts(const char** font_files, const unsigned int num_files,
                      const char* db_path, const AssfontsLogCallback cb,
                      const enum ASSFONTS_LOG_LEVEL log_level);

void AssfontsFreeString(char* str);
}

#endif